{
  "name": "@deepseek-ai/dsh-toolkit",
  "description": "DSH zero-dependency toolkit collection: time / encoding / json / calculator / csv / regex in one entry point",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:all": "bash scripts/build-all.sh",
    "test:all": "bash scripts/test-all.sh",
    "link-deps": "bash scripts/link-deps.sh",
    "prepack": "npm run build:all"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "*",
    "cordis": "*"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "packages",
    "scripts",
    "cordis.patch.yml"
  ]
}
